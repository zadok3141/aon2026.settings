<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <genericsetup:upgradeSteps
      profile="aon2026.settings:default"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Set the easyform upload limit to 25 MB (easyform.max_filesize)"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="aon2026.settings:default"
      source="1001"
      destination="1002"
      >
    <genericsetup:upgradeDepends
        title="Replace the 'New website goes here' placeholder site action with 'The Audit Office website' (ao.parliament.nz)"
        import_steps="actions"
        />
  </genericsetup:upgradeSteps>

  <!-- -*- extra stuff goes here -*- -->

</configure>
